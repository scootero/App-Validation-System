# Platform setup — copy to .env and fill in values.
# NEVER commit .env. Production secrets → n8n Credentials UI.

# Vercel (token → n8n Credentials only; leave empty here if preferred)
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

# Google Cloud / Drive / Sheets
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_JSON=   # path to JSON file, OR paste in n8n Credentials only

DRIVE_PARENT_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Sheet1

# n8n
N8N_BASE_URL=
N8N_ADMIN_EMAIL=

# GitHub → Vercel build model (PAT → n8n Credentials)
GITHUB_PAT=
GITHUB_ORG_OR_USER=
LANDING_TEMPLATE_REPO=

# Optional
ALERT_WEBHOOK_URL=
WEBHOOK_AUTH_SECRET=
DRIVE_POLL_INTERVAL_MIN=5
